# OmniApply AI Configuration & Secrets Template
# Copy this file to .env and fill in your actual credentials.

# AI LLM Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash

# SMTP Email Configuration (for auto-dispatching applications & alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM="OmniApply Alerts <your-email@example.com>"

# Supabase Cloud Database (Optional - falls back to local SQLite)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App settings
PORT=8000
AUTO_APPLY_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
DEFAULT_USER_EMAIL=candidate@example.com
